# --- URL publique du site (sans slash final) ---
NEXT_PUBLIC_SITE_URL=https://attriba.fr

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=sk_live_xxx
# IDs des prix créés dans Stripe (Produits > Ajouter un produit)
STRIPE_PRICE_MEMOIRE=price_xxx   # Mémoire Express — 590 € HT (708 € TTC si TVA)
STRIPE_PRICE_AUDIT=price_xxx     # Audit Flash — 90 € HT

# --- Supabase (https://supabase.com > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé service_role, JAMAIS exposée côté client

# --- Tracking (laisser vide pour désactiver) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

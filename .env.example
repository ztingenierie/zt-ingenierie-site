# =====================================================================
#  ZT Video Studio — configuration
# =====================================================================
# Choisis le fournisseur de génération vidéo.
#   - "mock"     : aucun coût, vidéo de démo (idéal pour tester l'UX)
#   - "selfhost" : TON moteur open-weight sur TON GPU (engine/), aucune API tierce
#   - "fal"      : génération via fal.ai (Veo, Kling, Seedance, Minimax, Wan)
VIDEO_PROVIDER=mock

# --- Moteur auto-hébergé (provider "selfhost") ---
# Lance le moteur Python dans engine/ (voir engine/README.md), puis :
ENGINE_URL=http://localhost:8000

# --- fal.ai (provider "fal") ---
# Crée une clé sur https://fal.ai/dashboard/keys
FAL_KEY=

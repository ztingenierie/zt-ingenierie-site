# =====================================================================
#  ZT Video Studio — configuration
# =====================================================================
# Choisis le fournisseur de génération vidéo.
#   - "mock"  : aucun coût, renvoie une vidéo de démo (idéal pour tester l'UX)
#   - "fal"   : génération réelle via fal.ai (Veo, Kling, Seedance, Minimax, Wan)
VIDEO_PROVIDER=mock

# --- fal.ai (recommandé : héberge les mêmes modèles que Higgsfield) ---
# Crée une clé sur https://fal.ai/dashboard/keys
FAL_KEY=

# --- Replicate (alternative) ---
# REPLICATE_API_TOKEN=
